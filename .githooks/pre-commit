#!/usr/bin/env bash
# Barra commit que tente subir dado pessoal de cliente (CPF, RG, filiação,
# data de nascimento). Roda só sobre o que está sendo adicionado (linhas
# "+" do diff staged), não sobre o arquivo inteiro.
#
# Ativar: git config core.hooksPath .githooks
set -euo pipefail

diff="$(git diff --cached -U0 --no-color)"
[ -z "$diff" ] && exit 0

falhou=0
arquivo=""

while IFS= read -r linha; do
  case "$linha" in
    "+++ b/"*) arquivo="${linha#+++ b/}"; continue ;;
    "+"*) conteudo="${linha#+}" ;;
    *) continue ;;
  esac

  if echo "$conteudo" | grep -qE '[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}'; then
    echo "PRE-COMMIT: possível CPF em $arquivo:"
    echo "  $conteudo"
    falhou=1
  fi

  if echo "$conteudo" | grep -qE '\b[0-9]{1,2}\.[0-9]{3}\.[0-9]{3}-[0-9Xx]\b'; then
    echo "PRE-COMMIT: possível RG em $arquivo:"
    echo "  $conteudo"
    falhou=1
  fi

  if echo "$conteudo" | grep -qiE '\b(filiacao|filiação|nascimento)\s*[:=]'; then
    echo "PRE-COMMIT: campo de dado pessoal (filiação/nascimento) em $arquivo:"
    echo "  $conteudo"
    falhou=1
  fi
done <<< "$diff"

if [ "$falhou" -eq 1 ]; then
  echo ""
  echo "Commit recusado: parece conter dado pessoal de cliente (CPF, RG, filiação ou nascimento)."
  echo "Se for exemplo fictício de propósito, evite o formato NNN ponto NNN ponto NNN traço NN."
  exit 1
fi

exit 0
